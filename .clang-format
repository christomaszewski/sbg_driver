---
Language: Cpp
BasedOnStyle: Google

AccessModifierOffset: -2
AlignAfterOpenBracket: AlwaysBreak
BraceWrapping:
  AfterClass: true
  AfterFunction: true
  AfterNamespace: true
  AfterStruct: true
  AfterEnum: true
BreakBeforeBraces: Custom
ColumnLimit: 100
ConstructorInitializerIndentWidth: 0
ContinuationIndentWidth: 2
DerivePointerAlignment: false
PointerAlignment: Middle
ReflowComments: false
LambdaBodyIndentation: OuterScope
AlignOperands: AlignAfterOperator
# Keep standard headers before third-party headers, as required by cpplint.
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^<[^/.]+>$'
    Priority: 2
  - Regex: '^<[^/]+\.h>$|^<(sys|arpa|netinet)/'
    Priority: 1
  - Regex: '^<'
    Priority: 3
  - Regex: '^"'
    Priority: 4
...
