#!/usr/bin/env bash
# sbg-up <sensor-config.yaml> [up [-d] | down | status | logs [args] | config | ...]
#
# Bring up ONE sbg sensor from ONE generic rig config (the single source of truth).
# Reads the config, derives the instance identity (ROS namespace /<name>; compose project = an
# inherited COMPOSE_PROJECT_NAME — rig owns it — or <service>_<name> standalone), renders the
# driver's ROS 2 params file, and runs `docker compose`. It SELECTS + PARAMETERIZES static compose
# files — it never generates one.
#
#   sbg-up sensors/sbg_a.yaml            # up (foreground)
#   sbg-up sensors/sbg_a.yaml up -d      # detached
#   sbg-up sensors/sbg_a.yaml status     # docker compose ps
#   sbg-up sensors/sbg_a.yaml logs -f
#   sbg-up sensors/sbg_a.yaml down
#   sbg-up sensors/sbg_a.yaml config     # render the merged compose
#   sbg-up /any/host/path/sbg_front.yaml up -d   # config from anywhere (rig)
#
# Multiple sensors = run it per config; each is its own compose project + ROS namespace, so
# instances never collide. This repo does NOT depend on rig (one-way; see rigging.yaml).
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${SBG_PYTHON:-python3}"

CONFIG="${1:?usage: sbg-up <sensor-config.yaml> [up [-d]|down|status|logs|config|...]}"
shift || true
[ -f "$CONFIG" ] || { echo "sbg-up: config not found: $CONFIG" >&2; exit 1; }
CONFIG_ABS="$(cd "$(dirname "$CONFIG")" && pwd)/$(basename "$CONFIG")"

if ! docker compose version >/dev/null 2>&1; then
  echo "sbg-up: needs the Docker Compose v2 plugin ('docker compose')" >&2
  exit 1
fi

# Read literal NUL-delimited key/value pairs. Never interpret YAML values as shell code.
ENV_FILE="$(mktemp)"
trap 'rm -f "$ENV_FILE"' EXIT
"$PYTHON" "$REPO/tools/render_params.py" --env0 "$CONFIG_ABS" > "$ENV_FILE"
while IFS= read -r -d '' key; do
  IFS= read -r -d '' value || { echo "sbg-up: truncated environment data" >&2; exit 1; }
  case "$key" in
    SERVICE|NAME|NAMESPACE|TYPE|DEVICE|REPLAY_HOST) export "$key=$value" ;;
    *) echo "sbg-up: unexpected environment key: $key" >&2; exit 1 ;;
  esac
done < "$ENV_FILE"
rm -f "$ENV_FILE"
trap - EXIT
PROJECT="${SERVICE}_${NAME}"

# Set mount paths before inspecting images; read-only queries never render files.
PARAMS_HOST="$REPO/var/run/${NAME}.params.yaml"

# Compose env: this instance's params file + ROS namespace. The deploy image is resolved by the
# compose file itself (SBG_IMAGE override -> RIG_IMAGE_REGISTRY -> local
# sbg_driver:latest), so a standalone run needs no rig and no registry; export
# SBG_IMAGE in your environment to force a specific image.
export SBG_PARAMS_HOST="$PARAMS_HOST"
export SBG_NAMESPACE="$NAMESPACE"

FILES=(-f "$REPO/docker/compose/compose.deploy.yaml")
if [ "${TYPE:-}" = "serial" ]; then
  export SBG_DEVICE="${DEVICE:?serial config needs connection.serial.by_id}"
  FILES+=(-f "$REPO/docker/compose/compose.deploy.serial.yaml")
elif [ "${TYPE:-}" = "file" ]; then
  export SBG_REPLAY_HOST="${REPLAY_HOST:?file config needs connection.file.path}"
  FILES+=(-f "$REPO/docker/compose/compose.deploy.file.yaml")
fi

# Verbs: `status` -> `ps`; everything else is forwarded to `docker compose` verbatim. No args = up.
ARGS=("$@")
[ ${#ARGS[@]} -eq 0 ] && ARGS=(up)
[ "${ARGS[0]}" = "status" ] && ARGS=(ps "${ARGS[@]:1}")

# rig owns the compose project name (it exports COMPOSE_PROJECT_NAME per call: <name>-vehicle-<id>);
# honor it when inherited, fall back to <service>_<name> standalone. NEVER pass -p — overriding the
# orchestrator's project name orphans the containers from `rig status`/`rig down`.
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$PROJECT}"

case "${ARGS[0]}" in
  runtime-images|images)
    exec "$PYTHON" "$REPO/tools/runtime_images.py" "${ARGS[0]}" "${FILES[@]}" ;;
esac
if [ "${ARGS[0]}" = up ] && [ "${RIG_RUNTIME_IMAGE_PINS+x}" ]; then
  "$PYTHON" "$REPO/tools/runtime_images.py" validate-pins "${FILES[@]}" -- "${ARGS[@]:1}"
fi

mkdir -p "$REPO/var/run"
"$PYTHON" "$REPO/tools/render_params.py" --container "$CONFIG_ABS" > "$PARAMS_HOST"
echo "sbg-up: project=$COMPOSE_PROJECT_NAME namespace=$NAMESPACE type=${TYPE:-?} params=$PARAMS_HOST" >&2
if [ "${ARGS[0]}" = up ] && [ "${RIG_RUNTIME_IMAGE_PINS+x}" ]; then
  exec "$PYTHON" "$REPO/tools/runtime_images.py" pinned-up "${FILES[@]}" -- "${ARGS[@]:1}"
fi
exec docker compose "${FILES[@]}" "${ARGS[@]}"
