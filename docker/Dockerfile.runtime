# syntax=docker/dockerfile:1
# Minimal production image. Self-contained two-stage build (no dependency on a
# published CI image): build with ros-base, ship on ros-core.
#
#   docker build -f docker/Dockerfile.runtime -t sbg_driver:<tag> .
# Cross-arch: prefix with `docker buildx build --platform linux/<arch> ... --load`.
#
# Structure tracks the template (boilerplate Dockerfile.runtime.jinja); the only
# project-specific divergence is the dependency lists below.
ARG ROS_DISTRO=lyrical

# ---- build stage ------------------------------------------------------------
FROM ros:${ROS_DISTRO}-ros-base AS build
ARG ROS_DISTRO=lyrical
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# git + ca-certificates: sbgECom is pulled via CMake FetchContent at configure time.
# nav-msgs/tf2-ros/std-srvs/rtcm-msgs/nmea-msgs are this driver's extra deps.
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential cmake ninja-build git ca-certificates \
      python3-colcon-common-extensions \
      ros-${ROS_DISTRO}-rclcpp ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-rclcpp-components ros-${ROS_DISTRO}-lifecycle-msgs \
      ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-diagnostic-msgs ros-${ROS_DISTRO}-diagnostic-updater \
      ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-std-srvs \
      ros-${ROS_DISTRO}-rtcm-msgs ros-${ROS_DISTRO}-nmea-msgs \
      ros-${ROS_DISTRO}-generate-parameter-library \
      ros-${ROS_DISTRO}-rosidl-default-generators ros-${ROS_DISTRO}-rosidl-default-runtime \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && colcon build --base-paths src --merge-install \
      --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-up-to sbg_driver

# ---- runtime stage ----------------------------------------------------------
FROM ros:${ROS_DISTRO}-ros-core AS runtime
ARG ROS_DISTRO=lyrical
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Runtime libs/typesupport the node loads. rsl: generate_parameter_library's
# generated code links librsl.so. rtcm_msgs/nmea_msgs/std_srvs: the /rtcm sub,
# /nmea pub, and mag-cal services. nav_msgs/tf2_ros: /odom + TF.
RUN apt-get update && apt-get install -y --no-install-recommends \
      ros-${ROS_DISTRO}-rclcpp ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-rclcpp-components ros-${ROS_DISTRO}-lifecycle-msgs \
      ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-diagnostic-msgs ros-${ROS_DISTRO}-diagnostic-updater \
      ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-std-srvs \
      ros-${ROS_DISTRO}-rtcm-msgs ros-${ROS_DISTRO}-nmea-msgs \
      ros-${ROS_DISTRO}-rsl ros-${ROS_DISTRO}-rosidl-default-runtime \
      ros-${ROS_DISTRO}-rmw-fastrtps-cpp \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/install /opt/sbg_driver
# Context is the repo root (build stage needs the sources), so entrypoints live under docker/.
COPY docker/entrypoints/ros-entrypoint.sh /usr/local/bin/ros-entrypoint.sh
COPY docker/entrypoints/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/ros-entrypoint.sh /usr/local/bin/healthcheck.sh

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV SBG_DRIVER_WORKSPACE=/opt/sbg_driver
# start-period covers configure->activate; timeout covers the ros2-CLI cold start the probe pays.
HEALTHCHECK --interval=30s --timeout=15s --start-period=30s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]
CMD ["ros2", "run", "sbg_driver", "sbg_driver_node"]
