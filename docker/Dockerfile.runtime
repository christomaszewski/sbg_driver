# syntax=docker/dockerfile:1
# Minimal production image. Self-contained two-stage build (no dependency on a
# published CI image): build with ros-base, ship on ros-core.
#
#   docker build -f docker/Dockerfile.runtime -t sbg_driver:<tag> .
# Cross-arch: prefix with `docker buildx build --platform linux/<arch> ... --load`.
#
# Structure tracks the template (boilerplate Dockerfile.runtime.jinja); the only
# project-specific divergence is the dependency lists below.
ARG ROS_DISTRO=lyrical
# Runtime parent. Under rig, tools/build_image.sh forwards RIG_BASE_IMAGE so the
# runtime stage re-parents onto the deployment's one shared base (fleet-ros =
# ros-base + rmw-zenoh + rosbag2/mcap): shared ros-* packages then come from
# literally the same layers as the router/bag-logger, and vehicle-side pull cost
# drops via layer sharing. Standalone builds keep the slim ros-core parent.
ARG BASE_IMAGE=ros:${ROS_DISTRO}-ros-core

# ---- build stage ------------------------------------------------------------
FROM ros:${ROS_DISTRO}-ros-base AS build
ARG ROS_DISTRO=lyrical
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# git + ca-certificates: sbgECom is pulled via CMake FetchContent at configure time.
# nav-msgs/tf2-ros/std-srvs/rtcm-msgs/nmea-msgs are this driver's extra deps.
#
# --no-upgrade, NOT dist-upgrade: no upgrades past the parent image (see the
# runtime stage's note for the fleet-wide invariant). The builder doesn't ship,
# but it must build against the same ros-* versions the runtime stage holds, so
# the same rule applies: parent-carried packages stay at parent versions.
RUN apt-get update && apt-get install -y --no-install-recommends --no-upgrade \
      build-essential cmake ninja-build git ca-certificates \
      python3-colcon-common-extensions \
      ros-${ROS_DISTRO}-rclcpp ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-rclcpp-components ros-${ROS_DISTRO}-lifecycle-msgs \
      ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-diagnostic-msgs ros-${ROS_DISTRO}-diagnostic-updater \
      ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-std-srvs \
      ros-${ROS_DISTRO}-rtcm-msgs ros-${ROS_DISTRO}-nmea-msgs \
      ros-${ROS_DISTRO}-generate-parameter-library \
      ros-${ROS_DISTRO}-rosidl-default-generators ros-${ROS_DISTRO}-rosidl-default-runtime \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
COPY . /workspace
RUN source "/opt/ros/${ROS_DISTRO}/setup.bash" \
 && colcon build --base-paths src --merge-install \
      --cmake-args -DCMAKE_BUILD_TYPE=Release --packages-up-to sbg_driver

# ---- runtime stage ----------------------------------------------------------
FROM ${BASE_IMAGE} AS runtime
ARG ROS_DISTRO=lyrical
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Runtime libs/typesupport the node loads. rsl: generate_parameter_library's
# generated code links librsl.so. rtcm_msgs/nmea_msgs/std_srvs: the /rtcm sub,
# /nmea pub, and mag-cal services. nav_msgs/tf2_ros: /odom + TF.
# Two RMW implementations ship so deployments can pick at start time via
# RMW_IMPLEMENTATION (compose already passes it through; default
# rmw_fastrtps_cpp). rmw_zenoh_cpp needs a zenoh router on the vehicle —
# `ros2 run rmw_zenoh_cpp rmw_zenohd` — which is deliberately NOT this
# container's job; run it as its own service.
# --no-upgrade: NO upgrades past the parent image. The locally-pulled parent is
# the ros-* version authority, advanced deliberately via `rig build --no-cache`
# (=> docker build --pull) — the fleet convergence rule adopted after rig image
# audit's cross-image agreement check found ros-* version skew between images
# dist-upgraded on different dates. The mixed-ABI hazard dist-upgrade used to
# address here (stale-base rmw_fastrtps crashing the node, ros2/rmw_fastrtps#905)
# is handled equally well by parent-sync: nothing upgrades past the parent, so
# preinstalled and newly-installed ros-* packages sit on the parent's one sync by
# construction — and unlike dist-upgrade, the invariant also holds ACROSS images
# sharing that parent. Accepted residual: --no-upgrade holds only the LISTED
# packages, so dependency-driven upgrades can still drift (same doctrine as rig
# v0.2.24's consumer mandate).
#
# The install list stays identical under both parents on purpose: under fleet-ros
# most packages are already present and apt no-ops or holds them (--no-upgrade);
# under the ros-core fallback they're needed. Don't special-case the two parents.
RUN apt-get update && apt-get install -y --no-install-recommends --no-upgrade \
      ros-${ROS_DISTRO}-rclcpp ros-${ROS_DISTRO}-rclcpp-lifecycle \
      ros-${ROS_DISTRO}-rclcpp-components ros-${ROS_DISTRO}-lifecycle-msgs \
      ros-${ROS_DISTRO}-sensor-msgs ros-${ROS_DISTRO}-geometry-msgs \
      ros-${ROS_DISTRO}-nav-msgs ros-${ROS_DISTRO}-std-msgs \
      ros-${ROS_DISTRO}-diagnostic-msgs ros-${ROS_DISTRO}-diagnostic-updater \
      ros-${ROS_DISTRO}-tf2-ros ros-${ROS_DISTRO}-std-srvs \
      ros-${ROS_DISTRO}-rtcm-msgs ros-${ROS_DISTRO}-nmea-msgs \
      ros-${ROS_DISTRO}-rsl ros-${ROS_DISTRO}-rosidl-default-runtime \
      ros-${ROS_DISTRO}-rmw-fastrtps-cpp ros-${ROS_DISTRO}-rmw-zenoh-cpp \
  && rm -rf /var/lib/apt/lists/*

COPY --from=build /workspace/install /opt/sbg_driver
# Context is the repo root (build stage needs the sources), so entrypoints live under docker/.
COPY docker/entrypoints/ros-entrypoint.sh /usr/local/bin/ros-entrypoint.sh
COPY docker/entrypoints/healthcheck.sh /usr/local/bin/healthcheck.sh
RUN chmod +x /usr/local/bin/ros-entrypoint.sh /usr/local/bin/healthcheck.sh

ENV LANG=C.UTF-8 LC_ALL=C.UTF-8
ENV SBG_DRIVER_WORKSPACE=/opt/sbg_driver
# start-period covers configure->activate; timeout covers the ros2-CLI cold start the probe pays
# twice in the worst case (daemon try + --no-daemon fallback, 8s each — see healthcheck.sh).
HEALTHCHECK --interval=30s --timeout=20s --start-period=30s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/local/bin/ros-entrypoint.sh"]
CMD ["ros2", "run", "sbg_driver", "sbg_driver_node"]
